# Railway: configure as variáveis no painel; não comite credenciais reais.
NODE_ENV=development
PORT=4173
PUBLIC_URL=http://localhost:4173
# Produção: adicionar PostgreSQL e referenciar a DATABASE_URL desse serviço.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=defina-uma-senha-forte-aqui
# Apenas desenvolvimento sem DATABASE_URL:
SQLITE_PATH=./data/development.sqlite
